#!/usr/bin/env python3
"""
言われたことを実行する。

  chibitaru-act "音量を上げて"
  chibitaru-act --json "電源を切って"

設計の考え方 — 「音量上げて」を判定するのに大きな言語モデルは要らない。
語の並びで足りるものは語で片づけ、そうでないものだけ Qwen に回す。
MYLN-FRAME を常駐させて重いものは呼ぶ時だけ、という方針と同じ。

触れるものそのものは lib/knobs.py の目録が持っている。ここは
「何を言われたか」を決めるだけで、どう動かすかは持たない。
以前は判定と実行の両方をここに書いていて、目録を足しても声からは
触れない、という食い違いが出た（音量は言えるのに明るさは言えない）。

戻り値:
  0  実行した
  3  意図は分かったが確認が要る（危ないもの）
  4  何を言われたか分からなかった
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import knobs  # noqa: E402
from knobs import sh  # noqa: E402


# ── 動作（設定ではなく、やること） ────────────────────────
def act_music(text: str) -> tuple[int, str]:
    if re.search(r"(次|つぎ|進め)", text):
        sh("mpc", "next")
        return 0, "次の曲にしました"
    if re.search(r"(前|まえ|戻)", text):
        sh("mpc", "prev")
        return 0, "前の曲に戻しました"
    if re.search(r"(止め|停止|とめ|やめ)", text):
        sh("mpc", "stop")
        return 0, "音楽を止めました"
    if re.search(r"(一時|ポーズ)", text):
        sh("mpc", "toggle")
        return 0, "一時停止しました"
    # 入っている曲がなければ、鳴らせない理由を言う。
    # mpc play は曲がなくても成功を返し、状態だけを出してくる。
    _, listed = sh("mpc", "playlist")
    if not listed.strip():
        _, allsongs = sh("mpc", "listall")
        if not allsongs.strip():
            return 1, "音楽が見つかりません。~/音楽 に入れてください"
        sh("mpc", "add", "/")
    rc, out = sh("mpc", "play")
    if rc != 0:
        return 1, "音楽を鳴らせませんでした"
    first = ""
    for line in out.splitlines():
        if line.strip() and not line.startswith(("volume:", "[")):
            first = line.strip()[:40]
            break
    return 0, f"音楽を流します {first}".strip()


def act_note(text: str) -> tuple[int, str]:
    """
    今日の日記を用意する。開くのは画面側の仕事なので、ここでは
    ファイルを作って場所を返すだけにする。
    """
    from datetime import date
    vault = None
    conf = Path("/etc/chibitaru/profile")
    if conf.is_file():
        for line in conf.read_text().splitlines():
            if line.startswith("CHIBITARU_VAULT="):
                vault = Path(line.partition("=")[2].strip())
    vault = vault or (Path.home() / "Vault")
    day = date.today().isoformat()
    path = vault / "日記" / f"{day}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.exists():
        path.write_text(f"# {day}\n\n", encoding="utf-8")
    return 0, f"今日の日記を用意しました|{path}"


def act_status(text: str) -> tuple[int, str]:
    """
    計器をまとめて言う。

    数字は目録から取る。ここで /proc を読み直していた頃は、電池を
    1 本しか見ておらず、画面（2 本合算）と食い違っていた。
    """
    parts = []
    for key in ("battery", "volume", "brightness", "mem", "temp"):
        k = knobs.BY_KEY[key]
        v = k.get() if k.get else None
        if v is not None:
            parts.append(f"{k.label} {v}{k.unit}")
    return 0, "、".join(parts) if parts else "分かりませんでした"


# ── 何を言われたのか ──────────────────────────────────────
# 「やること」を先に見る。設定より動作のほうが言い方が限られていて、
# 取り違えにくい。残りは目録に任せる。
ACTIONS = [
    ("music",  r"(音楽|曲|再生|流して|止めて|とめて|次の曲|前の曲|一時停止)", act_music),
    ("note",   r"(日記|ノート|メモ|書き留め)", act_note),
    ("status", r"(状態|具合|ぐあい|どうなって|全部)", act_status),
]


def emit(kind: str, rc: int, msg: str, as_json: bool, confirm: bool = False) -> int:
    # 「用意しました|パス」のように、後ろに場所を付けて返すものがある
    message, _, extra = msg.partition("|")
    if as_json:
        print(json.dumps({"kind": kind, "message": message, "path": extra or None,
                          "confirm": confirm, "ok": rc == 0}, ensure_ascii=False))
    else:
        print(message)
    return rc


# 不平は、向きを言っていない。「文字が小さくて読みにくい」は
# 小さくしろではなく大きくしろという意味で、語の並びでは逆に取れる
# （実機で実際に逆に動いた）。話の相手が要るのはこういう時なので、
# 語で決めつけずに AI へ回す。
COMPLAINT = re.compile(r"(にくい|づらい|辛い|つらい|見えない|聞こえない|疲れ|嫌|やだ)")

# 値を訊いているだけの言い方。これは答えるのが正しく、AI は要らない。
QUESTION = re.compile(r"(いくつ|どのくらい|どれくらい|何％|何%|教えて|\?|？)")


def ask_ai(text: str, as_json: bool, retry_knob=None) -> int:
    """
    語の並びで手に負えなかったものを AI に回す。

    ここまでで済むものは AI を呼ばない。呼べば数秒待たされるし、
    1.1GB を読み込む。「音量下げて」に 3 秒かける理由はない。
    分からなかった時だけ値段を払う。

    AI が居ない機体もある（モデルを入れていない、4GB で外してある）。
    その時は語の並びの結論に戻す。落ちるのではなく、できるところまで
    やって返す。
    """
    if "--no-ai" not in sys.argv:
        try:
            p = subprocess.run(["chibitaru-ai", "--json", text],
                               capture_output=True, text=True, timeout=150)
            out = json.loads(p.stdout)
            if out.get("ok"):
                return emit(out.get("kind") or "ai", 0,
                            out.get("message", ""), as_json)
        except (FileNotFoundError, subprocess.SubprocessError, ValueError):
            pass

    if retry_knob is not None:
        rc, msg = knobs.apply(retry_knob, text)
        return emit(retry_knob.key, rc, msg, as_json)
    return emit("unknown", 4, "うまく聞き取れませんでした", as_json)


def main() -> int:
    as_json = "--json" in sys.argv
    args = [a for a in sys.argv[1:] if a not in ("--json", "--no-ai")]
    if not args:
        print("何を言われたのか渡してください", file=sys.stderr)
        return 4
    text = " ".join(args)

    for name, pattern, fn in ACTIONS:
        if re.search(pattern, text):
            rc, msg = fn(text)
            return emit(name, rc, msg, as_json)

    k = knobs.find(text)
    if k is None:
        # 何を、が抜けた「下げて」「上げて」。この画面で上げ下げする
        # ものは音量が主なので、そう受け取る。聞き返すより早い。
        if re.search(r"(上げ|下げ|大きく|小さく|あげ|さげ)", text):
            k = knobs.BY_KEY["volume"]
        else:
            return ask_ai(text, as_json)

    if k.kind == "danger":
        # 実行しない。確認は画面側で取る。取り返しがつかないものを
        # 聞き間違いで実行しないため。
        word = "電源を切ります" if k.key == "power" else "再起動します"
        return emit(k.key, 3, f"{word}。よろしいですか？", as_json, confirm=True)

    # 不平は向きを言っていないので、語で決めつけない
    if COMPLAINT.search(text):
        return ask_ai(text, as_json, retry_knob=k)

    rc, msg = knobs.apply(k, text)

    # 話題は当たったが、どうしたいのかが分からなかった場合
    # （「うるさい」「まぶしい」）。ここで値を答えて済ませると、
    # 頼んだことが何も起きない。値を訊かれた時だけ答える。
    if msg.startswith("いまの") and not QUESTION.search(text):
        # 名前だけ言われた（「音量」）なら、答えるのが正しい
        rest = text
        for w in k.words:
            rest = rest.replace(w, " ")
        if rest.strip():
            return ask_ai(text, as_json, retry_knob=k)

    return emit(k.key, rc, msg, as_json)


if __name__ == "__main__":
    sys.exit(main())
