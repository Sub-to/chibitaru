#!/usr/bin/env bash
# 話した内容を Vault に書き留める。
#
#   chibitaru-listen           Enter を押すまで録音し、書き起こす
#   chibitaru-listen -s 10     10 秒録音して書き起こす
#   chibitaru-listen --stdout  Vault に書かず、画面に出すだけ
#   chibitaru-listen -y        確認せずに Vault へ書く
#   chibitaru-listen --level   書き起こさず音量だけ見る（調整用）
#
# 常時聞き耳を立てない。押している間だけ録音する。省電力のためでも
# あるが、それ以上に「いつ録っているか分からない機械」を持ち歩きたく
# ないため。録音した音声は書き起こしたあと消す。
#
set -euo pipefail

SECONDS_LIMIT=""
TO_STDOUT=false
NO_ASK=false
LEVEL_ONLY=false
while [ $# -gt 0 ]; do
  case "$1" in
    -s|--seconds) SECONDS_LIMIT="${2:-}"; shift 2 ;;
    --stdout)     TO_STDOUT=true; shift ;;
    -y|--yes)     NO_ASK=true; shift ;;
    --level)      LEVEL_ONLY=true; SECONDS_LIMIT="${SECONDS_LIMIT:-5}"; shift ;;
    --save-gate)
      # 測った値をこの機体に残す。次からこれを使う。
      [ "$(id -u)" = 0 ] || { echo "root で実行してください" >&2; exit 1; }
      install -d -m 755 /etc/chibitaru
      cat > /etc/chibitaru/mic <<EOF
# chibitaru-listen --save-gate が生成。実測にもとづく値。
CHIBITARU_MIC_GATE=${2:-400}
EOF
      echo "  聞き取りの門を ${2:-400} に設定しました"
      exit 0 ;;
    -h|--help)    sed -n '2,10p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "知らない指定: $1" >&2; exit 1 ;;
  esac
done

# ── 設定を読む ────────────────────────────────────────────
[ -r /etc/chibitaru/whisper ] || {
  echo "音声認識がまだ入っていません。" >&2
  echo "  sudo bash /opt/chibitaru/install/whisper.sh" >&2
  exit 1; }
# shellcheck disable=SC1091
. /etc/chibitaru/whisper
[ -x "${CHIBITARU_WHISPER_BIN:-}" ] || { echo "whisper が見つかりません" >&2; exit 1; }
[ -s "${CHIBITARU_WHISPER_MODEL:-}" ] || { echo "モデルが見つかりません" >&2; exit 1; }

VAULT="${CHIBITARU_VAULT:-}"
if [ -z "$VAULT" ] && [ -r /etc/chibitaru/profile ]; then
  VAULT=$(awk -F= '/^CHIBITARU_VAULT=/{print $2}' /etc/chibitaru/profile)
fi
[ -n "$VAULT" ] || VAULT="$HOME/Vault"

WAV=$(mktemp /tmp/chibitaru-listen.XXXXXX.wav)
# 音声はディスクに残さない。書き起こしたら消す。
trap 'rm -f "$WAV" "${WAV%.wav}"*.txt 2>/dev/null' EXIT

# ── 録音 ──────────────────────────────────────────────────
# whisper は 16kHz モノラルを食う。変換を挟まずそのまま録る。
if [ -n "$SECONDS_LIMIT" ]; then
  echo "  録音中… ${SECONDS_LIMIT}秒"
  timeout "$SECONDS_LIMIT" pw-record --channels=1 --rate=16000 "$WAV" \
    >/dev/null 2>&1 || true
else
  echo "  録音中… 話し終えたら Enter"
  pw-record --channels=1 --rate=16000 "$WAV" >/dev/null 2>&1 &
  rec_pid=$!
  read -r _ || true
  kill "$rec_pid" 2>/dev/null || true
  wait "$rec_pid" 2>/dev/null || true
fi

[ -s "$WAV" ] || { echo "  録音できませんでした（マイクを確認してください）" >&2; exit 1; }

# ── 声が入っているか確かめる ──────────────────────────────
# whisper は無音や雑音だけを渡されると、それらしい文を作り出す。
# 実機で環境音に対して「こんにちは、こんにちは」を延々と返した。
# それが Vault に残ると、言っていないことがノートに書かれてしまう。
# 全体の音量（RMS）で門を作る。頂点だけ見るとマイクの歪みに騙される。
LEVEL=$(python3 - "$WAV" <<'PY'
import array, sys, wave
try:
    w = wave.open(sys.argv[1])
    a = array.array("h")
    a.frombytes(w.readframes(w.getnframes()))
    if not a:
        print("0 0"); raise SystemExit
    rms = (sum(x * x for x in a) / len(a)) ** 0.5
    peak = max(abs(x) for x in a)
    print(f"{rms:.0f} {peak}")
except Exception:
    print("0 0")
PY
)
RMS=${LEVEL%% *}; PEAK=${LEVEL##* }

# ── 調整用: 数字だけ見せて終わる ──────────────────────────
# 環境も声の大きさも人と部屋で違う。こちらで固定値を当てるより、
# 実際に話して測ってもらうほうが早い。
if $LEVEL_ONLY; then
  vol=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | awk "{print \$2}")
  echo ""
  echo "  マイク音量  ${vol:-?}"
  echo "  RMS        ${RMS}"
  echo "  頂点       ${PEAK} / 32767"
  echo ""
  if [ "$PEAK" -ge 32700 ]; then
    echo "  → 割れています。音量を下げてください:"
    echo "      wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 40%"
  elif [ "$PEAK" -lt 3000 ]; then
    echo "  → 小さすぎます。音量を上げてください:"
    echo "      wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 80%"
  else
    echo "  → ちょうどよい範囲です（頂点 3000〜30000）"
  fi
  echo ""
  # 声と環境音の間に門を置く。対数の真ん中（相乗平均）を取ると、
  # どちらからも同じ比率だけ離れる。片側に寄せると、静かな声を
  # 弾くか、雑音を通すかのどちらかになる。
  SUGGEST=$(python3 -c "print(int(($RMS * 90) ** 0.5))" 2>/dev/null || echo 400)
  echo "  この声なら門は ${SUGGEST} あたりが妥当です。"
  echo "  保存するには:"
  echo "      sudo chibitaru-listen --save-gate ${SUGGEST}"
  echo ""
  exit 0
fi

# 門の高さ。環境音は部屋と時間で大きく変わる（同じ機体で RMS 322 と
# 2618 を観測した）ので、決め打ちの値は当てにならない。
# 既定は控えめにし、合わなければ CHIBITARU_MIC_GATE で変えられるように
# しておく。自分の声の RMS は chibitaru-listen --level で測れる。
# 門は機体ごとに測って決める。--level で保存できる。
GATE="${CHIBITARU_MIC_GATE:-}"
if [ -z "$GATE" ] && [ -r /etc/chibitaru/mic ]; then
  GATE=$(awk -F= '/^CHIBITARU_MIC_GATE=/{print $2}' /etc/chibitaru/mic)
fi
GATE="${GATE:-400}"
if [ "$RMS" -lt "$GATE" ]; then
  echo "  声が入っていません（音量 ${RMS} / 目安 ${GATE}以上）" >&2
  echo "  マイクに近づくか、もう少しはっきり話してください" >&2
  exit 1
fi
if [ "$PEAK" -ge 32700 ]; then
  echo "  ⚠ 音が割れています。マイクの音量を下げると精度が上がります:"
  echo "      wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 60%"
fi

# ── 書き起こし ────────────────────────────────────────────
# -bo 1 -bs 1 で候補を絞る。実機で測ったところ出力は一字一句同じで
# 10% 速くなった。読み込みは 102ms しかかからないので、常駐させても
# 速くはならない（待機 0MB のままでよい）。
#
# なお whisper は音声を 30 秒の塊に揃えて処理するので、5 秒の録音でも
# 30 秒ぶんの計算がかかる。短く録っても速くならない。
echo "  書き起こし中…"
start=$(date +%s)
# whisper は話し声でない音に (音楽) (拍手) [BLANK_AUDIO] のような注釈を返す。
# それはノートに書くべき内容ではないので、注釈だけの行は落とす。
TEXT=$("$CHIBITARU_WHISPER_BIN" \
        -m "$CHIBITARU_WHISPER_MODEL" \
        -f "$WAV" -l ja -nt -np -t "$(nproc)" \
        -nth 0.3 -lpt -0.5 -et 2.0 \
        -bo 1 -bs 1 2>/dev/null \
       | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
       | grep -vE '^$' \
       | grep -vE '^[（(\[].{0,12}[）)\]]$' \
       | grep -vE '^[♪♬~ー・…\.]+$' || true)
took=$(( $(date +%s) - start ))

if [ -z "$TEXT" ]; then
  echo "  何も聞き取れませんでした（${took}秒）" >&2
  exit 1
fi

echo ""
echo "$TEXT" | sed 's/^/  /'
echo ""
echo "  （${took}秒）"

$TO_STDOUT && exit 0

# ── 書く前に見せる ────────────────────────────────────────
# whisper は雑音から、それらしい文を作り出すことがある。実機で
# 環境音から「これがシンクとかの…」という架空の文が出た。
# この OS は書き起こしをノートに残すので、黙って書くと言っていない
# ことが記録される。押して録る使い方である以上、目の前にいるはずなので
# 一度見せて決めてもらう。
if ! $NO_ASK; then
  printf "  Vault に残しますか？ [Y/n] "
  read -r ans </dev/tty || ans=y
  case "${ans:-y}" in
    [nN]*) echo "  残しませんでした"; exit 0 ;;
  esac
fi

# ── Vault に残す ──────────────────────────────────────────
# この OS で起きたことは Markdown になって残る、という原則どおり。
DAY=$(date +%F)
OUT="${VAULT}/音声/${DAY}.md"
mkdir -p "$(dirname "$OUT")"
[ -f "$OUT" ] || printf '# %s の音声メモ\n' "$DAY" > "$OUT"
printf '\n## %s\n\n%s\n' "$(date +%H:%M)" "$TEXT" >> "$OUT"
echo "  → ${OUT}"
