#!/usr/bin/env bash
# いま動いているシステムを、指定したディスクへ複製する。
#
# USB から起動して使ってみて、気に入ったら内蔵ディスクへ移すためのもの。
# インストーラを起動し直す必要はない。設定もテーマも済んだ状態が
# そのまま移る。
#
#   chibitaru-to-disk /dev/sda            何をするか見せるだけ（消さない）
#   chibitaru-to-disk /dev/sda --yes      新規に作る（中身は消える）
#   chibitaru-to-disk /dev/sda --update   作り直さず差分だけ送る
#
# ⚠ --yes は指定したディスクの中身を完全に消す。
#    --update は消さない。既に入れてある先へ変更分を送るだけ。
#
set -euo pipefail

TARGET="${1:-}"
CONFIRM=false
UPDATE=false
for a in "$@"; do
  [ "$a" = "--yes" ]    && CONFIRM=true
  [ "$a" = "--update" ] && UPDATE=true
done

c_head() { printf "\n\033[1m  %s\033[0m\n" "$*"; }
c_ok()   { printf "    \033[32m*\033[0m %s\n" "$*"; }
c_warn() { printf "    \033[33m!\033[0m %s\n" "$*"; }
c_die()  { printf "\n  \033[31mNG: %s\033[0m\n\n" "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || c_die "root で実行してください"
[ -n "$TARGET" ]   || c_die "使い方: chibitaru-to-disk /dev/sda [--yes]"
[ -b "$TARGET" ]   || c_die "$TARGET はブロックデバイスではありません"

# ═══════════════════════════════════════════════════════════
# 安全確認 — ここを間違えると動いているシステムを消す
# ═══════════════════════════════════════════════════════════
ROOT_SRC=$(findmnt -no SOURCE /)
ROOT_DISK="/dev/$(lsblk -no PKNAME "$ROOT_SRC" | head -1)"

if [ "$TARGET" = "$ROOT_DISK" ]; then
  c_die "$TARGET は今このシステムが動いているディスクです"
fi

# 対象がマウント中でないか（別の場所で使われていたら止める）
if lsblk -no MOUNTPOINT "$TARGET" | grep -q .; then
  c_die "$TARGET のどこかがマウントされています。先に umount してください"
fi

BOOT_MODE=bios
[ -d /sys/firmware/efi ] && BOOT_MODE=uefi

TARGET_SIZE=$(( $(blockdev --getsize64 "$TARGET") / 1073741824 ))
USED_GB=$(df -BG --output=used / | tail -1 | tr -dc '0-9')
MODEL=$(lsblk -dno MODEL "$TARGET" | tr -s ' ')

[ "$TARGET_SIZE" -gt $(( USED_GB + 4 )) ] \
  || c_die "$TARGET が小さすぎます（${TARGET_SIZE}GB / 必要 $((USED_GB + 4))GB）"

# ═══════════════════════════════════════════════════════════
# --update : 作り直さず、差分だけ送る
# ═══════════════════════════════════════════════════════════
if $UPDATE; then
  PART="${TARGET}1"
  [ -b "$PART" ] || c_die "$PART がありません（先に --yes で作ってください）"
  MNT=/mnt/chibitaru-install
  mkdir -p "$MNT"
  mount "$PART" "$MNT" || c_die "$PART をマウントできません"
  [ -d "$MNT/opt/chibitaru" ] \
    || { umount "$MNT"; c_die "$PART に Chibitaru が入っていません"; }

  c_head "差分を送る（作り直しません）"
  # fstab と GRUB の設定は複製先固有のもの。上書きすると起動しなくなる。
  rsync -aHAXx --delete \
    --exclude='/dev/*' --exclude='/proc/*' --exclude='/sys/*' \
    --exclude='/tmp/*'  --exclude='/run/*'  --exclude='/mnt/*' \
    --exclude='/media/*' --exclude='/lost+found' --exclude='/swapfile' \
    --exclude='/etc/fstab' --exclude='/etc/fstab.*' \
    --exclude='/boot/grub/grub.cfg' --exclude='/boot/grub/grubenv' \
    / "$MNT/" 2>&1 | tail -2
  c_ok "同期完了"

  # 送ったあと、複製先の fstab がまだ自分の UUID を指しているか確かめる
  want=$(blkid -s UUID -o value "$PART")
  got=$(awk '$2=="/" && $1 !~ /^#/ {print $1}' "$MNT/etc/fstab" | head -1)
  if [ "$got" = "UUID=$want" ]; then
    c_ok "fstab は複製先の UUID のまま（$want）"
  else
    umount "$MNT"
    c_die "fstab が複製先を指していません（$got）。起動しなくなるため中断"
  fi

  sync; umount "$MNT" 2>/dev/null || umount -l "$MNT"
  printf "\n  完了しました。次の起動から反映されます。\n\n"
  exit 0
fi

# ═══════════════════════════════════════════════════════════
c_head "これから行うこと"
cat <<EOF
    複製元    ${ROOT_SRC}  (${ROOT_DISK}, 使用 ${USED_GB}GB)
    複製先    ${TARGET}  (${MODEL}, ${TARGET_SIZE}GB)
    起動方式  ${BOOT_MODE}

    ${TARGET} の中身は完全に消えます。現在そこにあるもの:
EOF
lsblk -o NAME,SIZE,FSTYPE,LABEL "$TARGET" | sed 's/^/      /'

if [ "$BOOT_MODE" = uefi ]; then
  c_warn "UEFI 起動です。このスクリプトは BIOS 起動しか作りません"
  c_die "UEFI 用の作成は未実装です"
fi

if ! $CONFIRM; then
  cat <<EOF

    まだ何もしていません。実行するには --yes を付けてください:

      chibitaru-to-disk ${TARGET} --yes

EOF
  exit 0
fi

# ═══════════════════════════════════════════════════════════
c_head "① パーティションを作る"
# BIOS 起動なので MBR ひとつで足りる。EFI 領域も BIOS boot 領域も要らない。
wipefs -a "$TARGET" >/dev/null
sfdisk --quiet --label dos "$TARGET" <<'EOF'
,,83,*
EOF
udevadm settle 2>/dev/null || sleep 2
PART="${TARGET}1"
[ -b "$PART" ] || c_die "$PART ができませんでした"
c_ok "$PART を作成（MBR・全体・起動可）"

c_head "② ファイルシステムを作る"
mkfs.ext4 -q -F -L chibitaru "$PART"
NEW_UUID=$(blkid -s UUID -o value "$PART")
c_ok "ext4 / ラベル chibitaru / UUID ${NEW_UUID}"

c_head "③ 中身を複製する"
MNT=/mnt/chibitaru-install
mkdir -p "$MNT"
mount "$PART" "$MNT"

# 仮想ファイルシステムと、複製先そのものは除く。
# /swapfile と古いバックアップも持っていかない。
rsync -aHAXx --info=progress2 \
  --exclude='/dev/*' --exclude='/proc/*' --exclude='/sys/*' \
  --exclude='/tmp/*'  --exclude='/run/*'  --exclude='/mnt/*' \
  --exclude='/media/*' --exclude='/lost+found' \
  --exclude='/swapfile' \
  / "$MNT/" 2>&1 | tail -3
mkdir -p "$MNT"/{dev,proc,sys,tmp,run,mnt,media}
chmod 1777 "$MNT/tmp"
c_ok "複製完了"

c_head "④ 起動設定を書き換える"
# fstab の / を新しい UUID にする。控えは残す。
cp -a "$MNT/etc/fstab" "$MNT/etc/fstab.before-install"
awk -v u="$NEW_UUID" '
  /^[[:space:]]*#/ { print; next }
  $2 == "/"        { print "UUID=" u, "/", $3, $4, $5, $6; next }
  # USB 上のスワップは持っていかない
  $3 == "swap"     { print "#", $0; next }
  { print }
' OFS="\t" "$MNT/etc/fstab.before-install" > "$MNT/etc/fstab"

findmnt --verify --tab-file "$MNT/etc/fstab" >/dev/null 2>&1 \
  || { cp -a "$MNT/etc/fstab.before-install" "$MNT/etc/fstab"
       c_die "fstab の検証に通りませんでした。何も壊していません"; }
c_ok "fstab を新しい UUID に更新"

c_head "⑤ GRUB を入れる"
for d in dev dev/pts proc sys; do mount --rbind "/$d" "$MNT/$d"; done
chroot "$MNT" grub-install --target=i386-pc "$TARGET" >/dev/null 2>&1 \
  || c_die "grub-install に失敗しました"
c_ok "GRUB を ${TARGET} に書いた"
chroot "$MNT" update-grub >/dev/null 2>&1 || c_warn "update-grub で警告"
c_ok "起動メニューを作成"
chroot "$MNT" update-initramfs -u >/dev/null 2>&1 || c_warn "initramfs で警告"
c_ok "initramfs を更新"

c_head "⑥ 後始末"
for d in sys proc dev/pts dev; do umount -lR "$MNT/$d" 2>/dev/null || true; done
sync
umount "$MNT" 2>/dev/null || umount -l "$MNT"
c_ok "アンマウント"

cat <<EOF

  完了しました。

    1. shutdown -h now で電源を切る
    2. USB を抜く
    3. 電源を入れる（そのまま内蔵ディスクから起動します）

  USB はそのまま残っているので、うまくいかなければ挿し直せば
  元の環境に戻れます。

EOF
