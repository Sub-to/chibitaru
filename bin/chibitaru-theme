#!/usr/bin/env bash
# 見た目を変える。テーマと文字サイズ。
#
#   chibitaru-theme                 いまの設定を見る
#   chibitaru-theme mocha           濃い青ベースにする
#   chibitaru-theme latte           薄い青ベースにする
#   chibitaru-theme fallout         緑の蛍光管にする
#   chibitaru-theme --size 18       文字を大きくする
#   chibitaru-theme latte --size 16 まとめて
#
# 変更したあとは chibitaru-theme --apply か、画面を開き直すと反映される。
#
set -euo pipefail

ROOT=/opt/chibitaru
SYS_CONF=/etc/chibitaru/theme
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/chibitaru/theme"
THEMES="mocha latte fallout"

# 見た目はその人の好みであって、機械の設定ではない。ふつうの利用者で
# 動かしたら自分のところに書き、root なら機械ぜんたいの既定を書く。
# こうしておくと「色を変えて」と声で言われた時に特権が要らない。
#
# /etc を誰でも書けるようにする手もあったが、あそこは root が読み込んで
# 実行に使う。開けると乗っ取られる道になるので、そちらは採らない。
if [ "$(id -u)" = 0 ]; then CONF="$SYS_CONF"; else CONF="$USER_CONF"; fi

theme=""; size=""; apply_now=false

while [ $# -gt 0 ]; do
  case "$1" in
    --size) size="${2:-}"; shift 2 ;;
    --apply) apply_now=true; shift ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
    mocha|latte|fallout) theme="$1"; shift ;;
    *) echo "知らない指定: $1（使えるのは $THEMES と --size）" >&2; exit 1 ;;
  esac
done

# ── いまの設定を読む ──────────────────────────────────────
cur_theme=mocha; cur_size=14
# 機械の既定を読んでから個人の好みで上書きする。source ではなく
# awk で取り出す。設定ファイルを読み込んで実行すると、そこに書けた
# 者が中身を動かせてしまう。
for f in "$SYS_CONF" "$USER_CONF"; do
  [ -r "$f" ] || continue
  t=$(awk -F= '/^CHIBITARU_THEME=/{print $2}' "$f"); [ -n "$t" ] && cur_theme="$t"
  z=$(awk -F= '/^CHIBITARU_FONT_SIZE=/{print $2}' "$f"); [ -n "$z" ] && cur_size="$z"
done

[ -n "$theme" ] || theme="$cur_theme"
[ -n "$size" ]  || size="$cur_size"

if ! printf '%s' "$size" | grep -qE '^[0-9]+$' || [ "$size" -lt 6 ] || [ "$size" -gt 48 ]; then
  echo "文字サイズは 6〜48 の数字で指定してください（指定: $size）" >&2
  exit 1
fi

# 引数なしなら今の設定を出して終わり
if [ -z "${1:-}" ] && [ "$theme" = "$cur_theme" ] && [ "$size" = "$cur_size" ] \
   && ! $apply_now && [ "$#" -eq 0 ] && [ -r "$CONF" ]; then
  : # 下で適用するので何もしない
fi

# ── 保存 ──────────────────────────────────────────────────
if mkdir -p "$(dirname "$CONF")" 2>/dev/null && : > "$CONF" 2>/dev/null; then
  cat > "$CONF" <<EOF
# chibitaru-theme が生成
CHIBITARU_THEME=${theme}
CHIBITARU_FONT_SIZE=${size}
EOF
else
  echo "設定を保存できません（$CONF に書けません）" >&2
  exit 1
fi

# ── foot に反映 ───────────────────────────────────────────
# 対象ユーザーの ~/.config/foot/foot.ini を作る
user="${CHIBITARU_USER:-}"
if [ -z "$user" ] && [ -r /etc/chibitaru/profile ]; then
  user=$(awk -F= '/^CHIBITARU_USER=/{print $2}' /etc/chibitaru/profile)
fi
[ -n "$user" ] || user=$(awk -F: '$3>=1000 && $3<65534 {print $1; exit}' /etc/passwd)
home=$(getent passwd "$user" | cut -d: -f6)

install -d -m 755 -o "$user" -g "$user" "$home/.config"
install -d -m 755 -o "$user" -g "$user" "$home/.config/foot"

{
  echo "# chibitaru-theme が生成。直接編集せず chibitaru-theme を使うこと。"
  echo "[main]"
  # 日本語を含むので CJK を持つフォントに落ちる必要がある。
  # monospace のままだと環境によっては日本語が豆腐になる。
  echo "font=monospace:size=${size}, Noto Sans Mono CJK JP:size=${size}"
  echo "pad=4x4"
  echo ""
  echo "[cursor]"
  echo "style=block"
  echo ""
  cat "$ROOT/profiles/foot/${theme}.ini"
} > "$home/.config/foot/foot.ini"
chown "$user:$user" "$home/.config/foot/foot.ini"

# ── TUI に反映 ────────────────────────────────────────────
# TUI は起動時に /etc/chibitaru/theme を読んで対応する tcss を使う
echo "  テーマ    ${theme}"
echo "  文字サイズ ${size}"

# ── 反映 ──────────────────────────────────────────────────
if $apply_now; then
  if pgrep -x labwc >/dev/null; then
    echo "  画面を開き直しています..."
    # tmux ごと畳む。chibitaru-session は既存セッションがあれば
    # 再接続するだけなので、端末を入れ替えても中の TUI は古い配色の
    # ままになる。実機で実際にそうなった。
    # 下のシェルの中身は失われるが、Vault はディスク上にあるので
    # 失うのは打ちかけのコマンドくらい。
    if [ "$(id -u)" = 0 ]; then
      su - "$user" -c "tmux kill-session -t chibitaru" 2>/dev/null || true
      systemctl restart getty@tty1
    else
      # 自分で立てたものを畳むだけなので特権は要らない。
      # tty1 は exec dbus-run-session labwc で入っているので、labwc が
      # 終わると agetty が入り直し、そのまま立ち上げ直してくれる。
      tmux kill-session -t chibitaru 2>/dev/null || true
      pkill -x labwc 2>/dev/null || true
    fi
    echo "  完了（下のシェルは真っさらになります）"
  else
    echo "  画面が動いていないので、次の起動から反映されます"
  fi
else
  echo ""
  echo "  反映するには:  chibitaru-theme --apply"
  echo "  （画面が一度閉じて開き直します）"
fi
