/* Catppuccin Latte — 薄い青ベース（明るい） */
Screen { layout: vertical; background: #eff1f5; color: #4c4f69; }
#body  { height: 1fr; }
#left  { width: 32; background: #e6e9ef; border-right: solid #ccd0da; }
VaultTree { height: 1fr; background: #e6e9ef; color: #4c4f69; }
VaultTree > .tree--cursor    { background: #1e66f5; color: #eff1f5; }
VaultTree > .tree--highlight { background: #ccd0da; }
#backlinks { height: 8; background: #e6e9ef; border-top: solid #ccd0da; padding: 0 1; }
#backlinks-title { color: #8c8fa1; }
#backlist { background: #e6e9ef; }
#backlist > ListItem { background: #e6e9ef; color: #179299; }
#backlist > ListItem.--highlight { background: #ccd0da; }
#right { width: 1fr; background: #eff1f5; }
Markdown { padding: 0 2; background: #eff1f5; color: #4c4f69; }
MarkdownH1 { color: #1e66f5; text-style: bold; }
MarkdownH2 { color: #7287fd; text-style: bold; }
MarkdownH3 { color: #179299; }
MarkdownBullet { color: #40a02b; }
MarkdownFence { background: #e6e9ef; }

Footer { background: #e6e9ef; color: #6c6f85; }
Footer > .footer--key { background: #1e66f5; color: #eff1f5; text-style: bold; }
#search { display: none; background: #ccd0da; color: #4c4f69; }
#search.visible { display: block; }
Toast { background: #ccd0da; color: #4c4f69; }

/* dock は使わない。同じ辺に複数置くと重なる（実機で
   お知らせと上部バーが両方 y=0 になった）。Screen が
   layout: vertical なので、書いた順に上から並ぶ。 */

/* 上部バー — 左に状態、右に日付と時刻 */
TopBar { height: 1; background: #ccd0da; color: #5c5f77; }
#top-state { width: auto; background: #ccd0da; }
#top-clock { width: 1fr; text-align: right; color: #1e66f5; background: #ccd0da; }

/* コンソールとの境目に線を引く。ここが曖昧だと
   どこまでが Vault でどこからがシェルか分かりにくい。 */
Footer { border-top: solid #acb0be; height: 2; }

/* 帯 — 左にお知らせ、右に大きい時計。どちらも 6 行の絵。
   端末では文字の大きさを場所ごとに変えられないので、大きく見せる
   ものは升目に絵として描いてある。 */
/* 枠線を引かない。border は height の内側を 1 行食うので、
   日付の行が消える（実機で消えた）。下の状態バーが色違いなので、
   線を引かなくても境目は分かる。 */
#band { height: 4; background: #e6e9ef; }

/* 字は普通の大きさのまま。升目に絵として描くと 6 行要るうえ、
   字の形が崩れて見え、流すだけで CPU を 21% 使った。
   帯そのものを広く取り、字は真ん中に置いて太くする。
   （絵で流したい時は ~/.config/chibitaru/news に
     CHIBITARU_NEWS_ART=1 と書く） */
NewsTicker {
    width: 1fr; height: 4;
    background: #e6e9ef; color: #d20f39;
    content-align: left middle;
    text-style: bold;
}

#bigclock {
    width: 33; height: 4;
    background: #e6e9ef; color: #1e66f5;
    content-align: center top;
}

/* 三つの列 — 左は蔵、真ん中は本文か AI、右は計器とボタン */
#left   { width: 22; }
#center { width: 1fr; }
#right  { width: 18; border-left: solid #ccd0da; }

/* AI の居場所 */
#ai { width: 1fr; height: 1fr; }
#ring { height: 1fr; padding-top: 2; color: #1e66f5; }
#ai-log { height: 5; padding: 0 1; color: #5c5f77; }

/* 計器 — 見るだけ。つまみは置かない（調整は声で） */
.panel-title { color: #8c8fa1; }
#mixer { height: 5; padding: 0 1; }
#mixer Label { color: #5c5f77; }
#music { height: 3; padding: 0 1; }
#mu-title { color: #8c8fa1; }
#mu-buttons { height: 1; }
.mu-btn { width: 3; content-align: center middle; color: #179299; }
.mu-btn:hover { background: #ccd0da; }

/* 大事なボタンだけは押せるようにしておく */
.switch {
    height: 1; margin: 0 1;
    background: #ccd0da; color: #5c5f77;
    content-align: left middle;
}
.switch:hover { background: #8c8fa1; }
#sw-power { color: #d20f39; }
#backlinks { height: 4; }
