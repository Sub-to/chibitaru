<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.masudatakaaki.kuramaru</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/masudatakaaki/ランドセル/kuramaru.py</string>
        <string>--watch</string>
        <string>--auto</string>
    </array>

    <!-- ログイン時に自動起動 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- クラッシュ時に自動再起動 -->
    <key>KeepAlive</key>
    <true/>

    <!-- ログ出力先 -->
    <key>StandardOutPath</key>
    <string>/Users/masudatakaaki/ランドセル/蔵丸_daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/masudatakaaki/ランドセル/蔵丸_daemon_error.log</string>

    <!-- 作業ディレクトリ -->
    <key>WorkingDirectory</key>
    <string>/Users/masudatakaaki/ランドセル</string>
</dict>
</plist>
